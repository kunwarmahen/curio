# Copy to .env and adjust. Every setting is optional; these are the defaults.

# --- LLM provider ---------------------------------------------------------
# auto: use Anthropic when ANTHROPIC_API_KEY is set, otherwise Ollama.
CURIO_LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...

# Model for every task (empty = provider default), plus optional per-task overrides.
CURIO_LLM_MODEL=
CURIO_LLM_MODEL_OUTLINE=
CURIO_LLM_MODEL_EVALUATE=
CURIO_LLM_MODEL_NOTES=
CURIO_LLM_MAX_RETRIES=2
CURIO_LLM_TEMPERATURE=0.2

# Ollama (local)
CURIO_OLLAMA_HOST=http://localhost:11434
CURIO_OLLAMA_DEFAULT_MODEL=qwen3.8-64k
# Context size used for every call (fixed, so the model loads once).
# 32768 keeps a 27B model fully on a 24 GB GPU; ~90 min of speech fits in one outline pass.
CURIO_OLLAMA_NUM_CTX=32768
CURIO_OLLAMA_TIMEOUT_S=1800

# Anthropic (cloud)
CURIO_ANTHROPIC_DEFAULT_MODEL=claude-opus-5-5
CURIO_ANTHROPIC_EFFORT=high

# Approximate token budgets. Longer transcripts are outlined in overlapping windows.
CURIO_OUTLINE_WINDOW_TOKENS=22000
CURIO_EVALUATE_BATCH_TOKENS=12000

# Move section starts to the exact sentence where the topic changes (one extra LLM call).
CURIO_REFINE_BOUNDARIES=true
# Find sponsor reads hidden inside content sections and cut them out (one LLM call).
CURIO_DETECT_ADS=true

# --- Transcripts -----------------------------------------------------------
CURIO_TRANSCRIPT_LANGUAGES=en,en-US,en-GB

# --- Scoring weights (normalized automatically) ------------------------------
CURIO_WEIGHT_EDUCATIONAL_VALUE=0.30
CURIO_WEIGHT_NOVELTY=0.20
CURIO_WEIGHT_PRACTICAL=0.20
CURIO_WEIGHT_DEPTH=0.15
CURIO_WEIGHT_RELEVANCE=0.15

# --- Playlist ----------------------------------------------------------------
CURIO_THRESHOLD_ESSENTIAL=70
CURIO_THRESHOLD_RECOMMENDED=55
CURIO_THRESHOLD_OPTIONAL=40
# Default watch-time budget: this fraction of the video, clamped to [min, max] minutes.
CURIO_BUDGET_FRACTION=0.30
CURIO_BUDGET_MIN_MINUTES=10
CURIO_BUDGET_MAX_MINUTES=35
# Selected sections closer than this are merged into one segment.
CURIO_MERGE_GAP_S=15

# --- Storage -------------------------------------------------------------
# Default: sqlite:///<project>/data/curio.db
# CURIO_DATABASE_URL=postgresql+psycopg://user:pass@localhost/curio

CURIO_LOG_LEVEL=INFO
